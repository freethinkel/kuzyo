{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# One wildcard certificate, so service names stay out of CT logs.
*.home.freethinkel.dev {
	@ha host ha.home.freethinkel.dev
	handle @ha {
		reverse_proxy localhost:8123
	}

	@photos host photos.home.freethinkel.dev
	handle @photos {
		reverse_proxy localhost:2283
	}

	@adguard host adguard.home.freethinkel.dev
	handle @adguard {
		reverse_proxy localhost:3000
	}

	handle {
		respond 404
	}
}

# Static sites for cloudflared.yml, on loopback only.
# collie.freethinkel.dev: the Collie landing page, from the Collie repo's make deploy-site.
http://:8090 {
	bind 127.0.0.1
	root * /srv/sites/collie
	file_server
}

# relay.freethinkel.dev: Collie's shared relay (collie-relay/), on loopback for cloudflared.yml. The relay
# rate-limits by the client's address, which only Cloudflare's Cf-Connecting-Ip carries here; a client's own
# X-Collie-Client-Ip is overwritten.
http://:8092 {
	bind 127.0.0.1
	@relay path /register /d/*
	handle @relay {
		reverse_proxy localhost:8091 {
			header_up X-Collie-Client-Ip {http.request.header.Cf-Connecting-Ip}
		}
	}
	handle {
		reverse_proxy localhost:7880
	}
}

# Start page, Glance in the apps container.
home.freethinkel.dev {
	reverse_proxy localhost:8080
}
