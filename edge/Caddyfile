{
	acme_dns cloudflare {env.CF_API_TOKEN}
}

# One wildcard certificate, so service names stay out of CT logs.
*.home.freethinkel.dev {
	@ha host ha.home.freethinkel.dev
	handle @ha {
		reverse_proxy localhost:8123
	}

	@photos host photos.home.freethinkel.dev
	handle @photos {
		reverse_proxy localhost:2283
	}

	@adguard host adguard.home.freethinkel.dev
	handle @adguard {
		reverse_proxy localhost:3000
	}

	handle {
		respond 404
	}
}

# Static sites for cloudflared.yml, on loopback only.
# collie.freethinkel.dev: the Collie landing page, from the Collie repo's make deploy-site.
http://:8090 {
	bind 127.0.0.1
	root * /srv/sites/collie
	file_server
}

# Start page, Glance in the apps container.
home.freethinkel.dev {
	reverse_proxy localhost:8080
}
