# Copy to .env and fill in. .env stays out of git; site.yml reads it directly.

# Cloudflare API token: Account / Cloudflare Tunnel / Edit, Zone / DNS / Edit,
# Zone / Zone / Read, limited to freethinkel.dev. Caddy uses it for DNS-01.
CLOUDFLARE_API_TOKEN=

# Tunnel credentials. The tunnel ID itself is public, in edge/cloudflared.yml.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_SECRET=

# openssl rand -hex 16
IMMICH_DB_PASSWORD=
SAMBA_PASSWORD=

# Login to meterreading-dso.eac.com.cy, for the electricity meter sensor in HA.
EAC_EMAIL=
EAC_PASSWORD=

# Root password for the local console, baked into preseed.cfg at install
# time: openssl passwd -6
ROOT_PASSWORD_HASH=
